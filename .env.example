# PMS 环境变量模板（复制为 .env 后按门店实际情况修改，不要提交到版本库）

# ── 必配：会话签名密钥 ──
# 生产环境缺此项会拒绝登录（见 DEPLOY.md）。生成方式：
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
#   或 openssl rand -hex 32
SESSION_SECRET=请替换成随机字符串

# 数据库文件位置（默认 <项目>/data/pms.db）
PMS_DB_PATH=./data/pms.db

# 酒店 ID（多店部署时区分，默认 1）
PMS_HOTEL_ID=1

# 营业日切换时间（HH:MM，凌晨几点算新的一天；酒店业常用 05:00）
PMS_BIZ_DATE_CUTOFF=05:00

# 允许 HTTP：仅本地 / 内网演示设为 1。
# 公网部署必须删除这一行并配置 HTTPS；删除后登录锁定、初始口令拦截、
# SESSION_SECRET 强制校验会自动生效。
PMS_ALLOW_HTTP=1

# 站点基址（用于登录跳转等绝对地址）
PMS_BASE_URL=http://localhost:3100

# 演示账号提示（历史变量，已废弃）
# 现在没有任何代码读取 PMS_SHOW_DEMO_HINT —— 设它不会打开也不会关闭演示入口，
# 请不要再用。演示入口的唯一开关是文末的 PMS_DEMO_LOGIN。
# PMS_SHOW_DEMO_HINT=1

# 渠道直连密钥（每家门店各自填写，切勿写进代码）
# CTIP_APP_KEY=
# CTIP_APP_SECRET=
# MEITUAN_APP_KEY=
# MEITUAN_APP_SECRET=

# ── 演示模式开关（正式上线必须关闭）──
#
# 判定口径集中在 src/lib/demo-mode.ts（登录页也走这里），是 fail-safe 的：
#   开启 = 显式写成 1 / true / yes / on
#   关闭 = 未设置、空、0 / false / no / off、以及任何拼错的值
# 也就是说：**正式环境不写这两行就是关闭状态**，不需要额外配置；
# 显式写上 =0 只是让配置更可读。上线前可用下面这条自检：
#   node scripts/check-production-config.mjs
#
# PMS_DEMO_LOGIN=1：登录页显示「一键填入演示账号」按钮（4 个账号，点一下就填入）
#   · 只在演示 / 培训 / 验收环境临时开
#   · 正式运营不要设：任何能打开登录页的人都能一键拿到 admin 口令
# PMS_DEMO_SEED=1：首次打开 AR / 商品 / 积分页面时自动灌入演示数据
#   · 只影响这几个模块的种子数据，同样不要在生产环境开
#   · 完整演示数据（46 房 / 588 预订 / 200 账单 / 45 客人）用下面的命令导入：
#       node scripts/load-demo.mjs
PMS_DEMO_LOGIN=0
PMS_DEMO_SEED=0
