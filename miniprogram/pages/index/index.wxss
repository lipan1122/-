/* 首页专有样式：日期选择行 + 房型卡片 */

.date-row {
  display: flex;
  align-items: center;
  margin-bottom: 8rpx;
}

.date-box {
  display: flex;
  flex-direction: column;
  justify-content: center;
  min-width: 220rpx;
  padding: 16rpx 24rpx;
  background: #f7f7fa;
  border-radius: 16rpx;
}

.date-value {
  margin-top: 6rpx;
  font-size: 32rpx;
  font-weight: 600;
  color: #1c1c1e;
}

.date-arrow {
  flex: 1;
  text-align: center;
  color: #c7c7cc;
  font-size: 28rpx;
}

.room-main {
  flex: 1;
  min-width: 0;
  padding-right: 16rpx;
}

.room-price {
  flex-shrink: 0;
  text-align: right;
}
