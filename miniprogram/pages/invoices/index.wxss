/* 发票页专有样式：发票列表 + 表单 */

.inv-item {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f0f0f2;
}

.inv-item:last-child {
  border-bottom: none;
  padding-bottom: 0;
}

.inv-main {
  flex: 1;
  min-width: 0;
  padding-right: 20rpx;
}

.inv-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1c1c1e;
}

.inv-right {
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
}

.inv-amount {
  font-size: 30rpx;
  font-weight: 600;
  color: #1c1c1e;
}

.copy-link {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #007aff;
}

.picker-value {
  flex: 1;
  text-align: right;
  font-size: 28rpx;
  color: #1c1c1e;
}

.empty-sub {
  padding: 40rpx 0 20rpx;
  text-align: center;
  color: #8e8e93;
  font-size: 26rpx;
}

.action-row {
  min-height: 88rpx;
}

.retry-link {
  display: inline-block;
  margin-left: 12rpx;
  color: #007aff;
  font-weight: 600;
}
