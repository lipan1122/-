/* 客房服务专有样式：服务类型网格 + 请求列表 */

.service-grid {
  display: flex;
  flex-wrap: wrap;
}

.service-item {
  width: 48%;
  margin: 0 4% 16rpx 0;
  padding: 20rpx;
  box-sizing: border-box;
  border-radius: 16rpx;
  background: #f7f7fa;
  border: 2rpx solid transparent;
  display: flex;
  flex-direction: column;
}

/* 两列布局：每行第 2 个不要右边距 */
.service-item:nth-child(2n) {
  margin-right: 0;
}

.service-item-on {
  background: #eef4ff;
  border-color: #007aff;
}

.service-label {
  font-size: 28rpx;
  font-weight: 600;
  color: #1c1c1e;
}

.service-desc {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #8e8e93;
}

.picker-value {
  flex: 1;
  text-align: right;
  font-size: 28rpx;
  color: #1c1c1e;
}

.textarea {
  width: 100%;
  min-height: 140rpx;
  padding: 16rpx;
  box-sizing: border-box;
  background: #f7f7fa;
  border-radius: 12rpx;
  font-size: 26rpx;
  color: #1c1c1e;
}

/* 份数 / 数量步进器 */
.stepper {
  display: flex;
  align-items: center;
}

.step-btn {
  width: 64rpx;
  height: 64rpx;
  line-height: 60rpx;
  text-align: center;
  border-radius: 50%;
  background: #f2f2f7;
  color: #007aff;
  font-size: 34rpx;
}

.step-value {
  min-width: 72rpx;
  text-align: center;
  font-size: 30rpx;
  font-weight: 600;
  color: #1c1c1e;
}

/* 服务请求列表 */
.order-item {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  padding: 22rpx 0;
  border-bottom: 1rpx solid #f0f0f2;
}

.order-item:last-child {
  border-bottom: none;
  padding-bottom: 0;
}

.order-main {
  flex: 1;
  min-width: 0;
  padding-right: 16rpx;
}

.order-label {
  display: block;
  font-size: 28rpx;
  color: #1c1c1e;
  margin-bottom: 4rpx;
}

.order-right {
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
}

.cancel-link {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #007aff;
}

.empty-sub {
  padding: 40rpx 0 20rpx;
  text-align: center;
  color: #8e8e93;
  font-size: 26rpx;
}

.retry-link {
  display: inline-block;
  margin-left: 12rpx;
  color: #007aff;
  font-weight: 600;
}
