/* 会员中心专有样式：资料卡 + 四宫格指标 */

.profile {
  background: linear-gradient(135deg, #ffffff 0%, #f7fbff 100%);
}

.stat-grid {
  display: flex;
  flex-wrap: wrap;
}

.stat {
  width: 50%;
  padding: 12rpx 0;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
}

.stat-value {
  font-size: 36rpx;
  font-weight: 600;
  color: #1c1c1e;
  margin-bottom: 4rpx;
}
