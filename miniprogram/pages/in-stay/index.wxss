/* 在住服务专有样式：房间号大字 + 服务入口网格 */

.room-no {
  font-size: 46rpx;
  font-weight: 700;
  color: #1c1c1e;
  letter-spacing: 2rpx;
}

.stay-cell {
  display: flex;
  flex-direction: column;
  width: 50%;
}

.stay-value {
  margin-top: 4rpx;
  font-size: 26rpx;
  font-weight: 500;
  color: #1c1c1e;
}

.entry-grid {
  display: flex;
  flex-wrap: wrap;
}

.entry {
  width: 50%;
  box-sizing: border-box;
  padding: 28rpx 24rpx;
  border-bottom: 1rpx solid #f0f0f2;
  display: flex;
  flex-direction: column;
}

/* 奇数个入口时最后一行不画多余的下边框 */
.entry:nth-last-child(1),
.entry:nth-last-child(2) {
  border-bottom: none;
}

.entry:nth-child(odd) {
  border-right: 1rpx solid #f0f0f2;
}

.entry-label {
  font-size: 30rpx;
  font-weight: 500;
  color: #1c1c1e;
}

.entry-desc {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #8e8e93;
}

.footer-tip {
  padding: 8rpx 8rpx 32rpx;
  line-height: 1.6;
}

.retry-link {
  display: inline-block;
  margin-left: 12rpx;
  color: #007aff;
  font-weight: 600;
}
