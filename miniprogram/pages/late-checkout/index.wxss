/* 延迟退房专有样式：时间选项 + 说明 */

.chip-row {
  display: flex;
  flex-wrap: wrap;
}

.chip-tap {
  margin: 0 12rpx 12rpx 0;
  padding: 10rpx 26rpx;
  font-size: 26rpx;
}

/* 选中态：蓝色实心，和 chip-gray 明显区分 */
.chip-on {
  background: #007aff;
  color: #ffffff;
}

.textarea {
  width: 100%;
  min-height: 140rpx;
  padding: 16rpx;
  box-sizing: border-box;
  background: #f7f7fa;
  border-radius: 12rpx;
  font-size: 26rpx;
  color: #1c1c1e;
}

.footer-tip {
  padding: 16rpx 8rpx 32rpx;
  line-height: 1.6;
}

.retry-link {
  display: inline-block;
  margin-left: 12rpx;
  color: #007aff;
  font-weight: 600;
}
