/* 当前账单专有样式：明细行 + 合计高亮 */

.empty-sub {
  padding: 60rpx 0 40rpx;
  text-align: center;
  color: #8e8e93;
  font-size: 26rpx;
}

.bill-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  padding: 22rpx 0;
  border-bottom: 1rpx solid #f0f0f2;
}

.bill-row:last-child {
  border-bottom: none;
  padding-bottom: 0;
}

.bill-main {
  flex: 1;
  min-width: 0;
  padding-right: 20rpx;
}

.bill-desc {
  display: block;
  font-size: 28rpx;
  color: #1c1c1e;
  margin-bottom: 4rpx;
}

.bill-amount {
  flex-shrink: 0;
  font-size: 28rpx;
  font-weight: 600;
  color: #1c1c1e;
}

/* 付款 / 退款 / 冲账：绿色，和消费区分开 */
.bill-credit {
  color: #1c9e4a;
}

.summary-card {
  background: linear-gradient(135deg, #ffffff 0%, #f7fbff 100%);
}

.action-row {
  min-height: 88rpx;
}

.retry-link {
  display: inline-block;
  margin-left: 12rpx;
  color: #007aff;
  font-weight: 600;
}
