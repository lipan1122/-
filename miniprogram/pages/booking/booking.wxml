<!--*
 * 下单页
 *
 * 数据来源：POST /api/mini/bookings（需要 Bearer token）
 * 入参：{ roomTypeId, checkInDate, checkOutDate, roomCount, guestName, mobile, remark }
 * 价格由服务端按房价日历重算，页面上展示的金额只作参考。
 -->
<view class="container">
  <!-- 房型与日期 -->
  <view class="card">
    <view class="row">
      <text class="title">{{roomTypeName}}</text>
      <text class="chip chip-green">{{nights}} 晚</text>
    </view>
    <view class="divider"></view>
    <view class="row">
      <text class="subtitle">入住</text>
      <text class="muted">{{checkIn}}</text>
    </view>
    <view class="row gap-top">
      <text class="subtitle">离店</text>
      <text class="muted">{{checkOut}}</text>
    </view>
    <view class="row gap-top">
      <text class="subtitle">单间房价</text>
      <text class="price">¥{{perRoomText}}<text class="price-unit">/{{nights}}晚</text></text>
    </view>
  </view>

  <!-- 入住人信息 -->
  <view class="card">
    <view class="field">
      <text class="field-label">入住人</text>
      <input
        class="field-input"
        placeholder="请填写入住人姓名"
        placeholder-class="field-input-placeholder"
        value="{{guestName}}"
        maxlength="30"
        bindinput="onNameInput"
      />
    </view>
    <view class="field">
      <text class="field-label">手机号</text>
      <input
        class="field-input"
        type="number"
        placeholder="用于前台联系，11 位手机号"
        placeholder-class="field-input-placeholder"
        value="{{mobile}}"
        maxlength="11"
        bindinput="onMobileInput"
      />
    </view>
    <view class="field">
      <text class="field-label">房间数</text>
      <picker mode="selector" range="{{countRange}}" value="{{countIndex}}" bindchange="onCountChange">
        <view class="picker-value">{{roomCount}} 间（最多 {{maxCount}} 间）</view>
      </picker>
    </view>
    <view class="field">
      <text class="field-label">备注</text>
      <input
        class="field-input"
        placeholder="选填，如预计到店时间 / 无烟房"
        placeholder-class="field-input-placeholder"
        value="{{remark}}"
        maxlength="100"
        bindinput="onRemarkInput"
      />
    </view>
  </view>

  <view wx:if="{{error}}" class="error-box">{{error}}</view>

  <!-- 合计 + 提交 -->
  <view class="card">
    <view class="row">
      <text class="subtitle">合计（{{roomCount}} 间 · {{nights}} 晚）</text>
      <text class="price">¥{{totalText}}</text>
    </view>
    <view class="muted gap-top">到店付款，前台办理入住时收取房费与押金</view>
    <button class="btn" bindtap="onSubmit" disabled="{{submitting}}">
      {{submitting ? '提交中…' : '提交订单'}}
    </button>
  </view>
</view>
